# Etsy API Credentials
# Get these from https://www.etsy.com/developers/your-apps
ETSY_API_KEYSTRING=your_keystring_here
ETSY_SHARED_SECRET=your_shared_secret_here

# Flask secret key (generate a random one)
FLASK_SECRET_KEY=change-this-to-a-random-secret-key

# OAuth callback URL (must match what you set in Etsy app settings)
REDIRECT_URI=http://localhost:5000/oauth/callback
